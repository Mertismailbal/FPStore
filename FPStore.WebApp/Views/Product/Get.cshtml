@section Scripts {
<script>
  const thumbnailsContainer = document.querySelector('.d-flex.gap-2');
  const mainImage = document.getElementById('mainImage');

  // Başlangıç ana resim ID'si
  let currentMain = {
    id: '122'
  };

  // Her thumbnail'a click olayı bağlayan fonksiyon
  function setupThumbnailClick(thumb) {
    thumb.addEventListener('click', () => {
      const clickedThumb = thumb;
      const fullSrc = clickedThumb.dataset.full;
      const thumbSrc = clickedThumb.src;

      // Ana resim ID'sini çıkar
      const newIdMatch = fullSrc.match(/id\/(\d+)\//);
      const newId = newIdMatch ? newIdMatch[1] : null;

      if (!newId) return;

      // 1. Ana resmi güncelle
      mainImage.src = fullSrc;

      // 2. Thumbnail sırasını kaydet
      const index = Array.from(thumbnailsContainer.children).indexOf(clickedThumb);

      // 3. Thumbnail'ı kaldır
      thumbnailsContainer.removeChild(clickedThumb);

      // 4. Önceki ana resmi thumbnail olarak oluştur
      const oldThumb = document.createElement('img');
      oldThumb.src = `https://picsum.photos/id/${currentMain.id}/100/100`;
      oldThumb.className = 'img-thumbnail thumb';
      oldThumb.setAttribute('data-full', `https://picsum.photos/id/${currentMain.id}/500/400`);
      oldThumb.alt = 'Thumb ' + currentMain.id;

      // Yeni oluşturulan thumbnail'a tıklama fonksiyonu bağla
      setupThumbnailClick(oldThumb);

      // Eski thumbnail pozisyonuna ekle
      if (index >= thumbnailsContainer.children.length) {
        thumbnailsContainer.appendChild(oldThumb);
      } else {
        thumbnailsContainer.insertBefore(oldThumb, thumbnailsContainer.children[index]);
      }

      // Ana resmi güncelle
      currentMain.id = newId;
    });
  }

  // İlk thumbnail'lara olayı bağla
  const initialThumbnails = document.querySelectorAll('.thumb');
  initialThumbnails.forEach(thumb => setupThumbnailClick(thumb));
</script>

}